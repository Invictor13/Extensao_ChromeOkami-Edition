{
  "manifest_version": 3,
  "name": "Okami HUD",
  "version": "0.1.0",
  "description": "Interface minimalista, contextual e acionada por bordas para Google Chrome.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "src/content/components/OkamiHUDRoot.js",
        "src/content/index.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "chrome_url_overrides": {
    "newtab": "src/newtab/index.html"
  },
  "action": {
    "default_title": "Okami HUD"
  },
  "commands": {
    "toggle-immersive-mode": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Alternar modo imersivo"
    },
    "toggle-hud-visibility": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "mac": "Alt+Shift+H"
      },
      "description": "Mostrar ou ocultar o HUD superior"
    },
    "toggle-left-panel": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Alt+Shift+L"
      },
      "description": "Abrir ou fechar o painel lateral esquerdo"
    },
    "toggle-right-panel": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Abrir ou fechar o painel lateral direito"
    }
  }
}
